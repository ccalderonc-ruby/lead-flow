#!/usr/bin/env sh

cd "$(dirname "$0")/.." || exit 1

# Load project .env into this process so empty placeholder STRIPE_* (or PORT)
# vars from the parent environment cannot block dotenv-rails / Puma.
if [ -f .env ]; then
  set -a
  # shellcheck disable=SC1091
  . ./.env
  set +a
fi

export PORT="${PORT:-3000}"

echo ""
echo "  LeadFlow app:  http://localhost:${PORT}/login"
echo "  (Port 3036 is Vite assets only — do not open it in the browser)"
echo ""

if command -v overmind 1> /dev/null 2>&1
then
  # -N: don't reassign $PORT per process (otherwise web becomes base+100, e.g. 3100).
  overmind start -f Procfile.dev -N "$@"
  exit $?
fi

if command -v hivemind 1> /dev/null 2>&1
then
  echo "Hivemind is installed. Running the application with Hivemind..."
  exec hivemind Procfile.dev "$@"
  exit $?
fi

if gem list --no-installed --exact --silent foreman; then
  echo "Installing foreman..."
  gem install foreman
fi

foreman start -f Procfile.dev "$@"
