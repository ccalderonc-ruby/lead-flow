# Stripe test-mode keys (never commit real secrets).
# Quick local setup:
#   1. brew install stripe/stripe-cli/stripe
#   2. stripe sandbox create --from-git   # or: stripe login
#   3. Create a Product + recurring Price in Dashboard (or via CLI)
#   4. Copy keys below into .env (gitignored)
#   5. stripe listen --forward-to localhost:3000/webhooks/stripe
#      → paste the whsec_… value into STRIPE_WEBHOOK_SECRET
#   6. Restart bin/rails server
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Video conferences (B8) — app-level Zoom / Google Meet.
# Stub-first: leave VIDEO_CONFERENCE_LIVE unset/false to generate stub join URLs.
# VIDEO_CONFERENCE_LIVE=true
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# GOOGLE_MEET_CLIENT_EMAIL=
# GOOGLE_MEET_PRIVATE_KEY=
# GOOGLE_MEET_CALENDAR_ID=

# Outbound email (password reset, etc.)
# Development defaults to letter_opener (emails open in the browser).
# For real delivery (Gmail/SendGrid/Mailgun SMTP, etc.), set SMTP_ADDRESS:
MAIL_FROM=LeadFlow <noreply@yourdomain.com>
# APP_HOST=leadflow.example.com
# APP_PROTOCOL=https
# SMTP_ADDRESS=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_DOMAIN=yourdomain.com
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS=true
